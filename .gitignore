# Python bytecode / caches
__pycache__/
*.pyc
*.pyo

# Blender backups
*.blend1
*.blend2

# Retail-only data, excluded to keep the repo lean:
#   - pywowlib/archives/listfile.csv : 77 MB community CASC listfile (retail filename map)
pywowlib/archives/listfile.csv

# pywowlib/wdbx/dbd/ is the WoWDBDefs checkout. dbd_wrapper.py reads
# dbd/definitions/*.dbd to parse DBCs on import, so those ARE needed for Classic
# work and must be committed. The rest (analytics/code/exedumper/schlumpf tooling,
# README, and any *.bak) is not used at runtime — keep it ignored.
pywowlib/wdbx/dbd/*
!pywowlib/wdbx/dbd/definitions/
pywowlib/wdbx/dbd/definitions/*
!pywowlib/wdbx/dbd/definitions/*.dbd
